# Runtime
NODE_ENV=development
APP_NAME=Event Forecast Lab
WEB_PORT=3000
API_PORT=4000
WORKER_ENABLED=true

# Local infrastructure
DATABASE_URL=postgresql://forecast:forecast@localhost:5432/forecast
REDIS_URL=redis://localhost:6379

# Public external data
POLYMARKET_GAMMA_BASE_URL=https://gamma-api.polymarket.com
POLYMARKET_CLOB_BASE_URL=https://clob.polymarket.com
POLYMARKET_MARKET_WS_URL=wss://ws-subscriptions-clob.polymarket.com/ws/market
POLYMARKET_SYNC_INTERVAL_MS=60000
POLYMARKET_REQUEST_TIMEOUT_MS=10000

# Security placeholders — generate unique values before any public deployment
SESSION_SECRET=replace-with-at-least-32-random-characters
INTERNAL_API_KEY=replace-with-a-random-development-key

# Feature flags
FEATURE_PREDICTIONS_ENABLED=false
FEATURE_DAILY_REWARDS_ENABLED=false
FEATURE_LEADERBOARD_ENABLED=false
FEATURE_SOCIAL_ENABLED=false
